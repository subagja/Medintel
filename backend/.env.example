# Contoh lingkungan LOKAL. Jangan masukkan password sebenarnya ke Git.
DJANGO_SECRET_KEY=replace-with-unique-long-secret
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Pengaturan default database lokal saat ini ada di config/settings.py.
# DB_PASSWORD dipakai fallback; untuk database non-default gunakan DATABASE_URL.
DB_PASSWORD=replace-with-local-db-password
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# OPENAI_API_KEY=replace-with-api-key-in-local-env-only
